# ============================================================
# Dockerfile.cuda12 — vLLM with CUDA 12 for Qwen-Coder models
# ============================================================
# Based on the official vLLM Docker image.
# This is a lab/development Dockerfile, not a production build.
#
# Build:
#   docker build -f docker/Dockerfile.cuda12 -t debuga-vllm:latest .
#
# Run:
#   docker run --gpus all -p 8000:8000 debuga-vllm:latest
# ============================================================

FROM vllm/vllm-openai:latest

LABEL maintainer="Sperry Tecnologia <contato@sperrytecnologia.com.br>"
LABEL description="vLLM inference engine for Qwen-Coder models (lab environment)"
LABEL org.opencontainers.image.source="https://github.com/SperryTecnologia/debuga-vllm-engine"

# Environment defaults (override via .env or docker-compose)
ENV MODEL_ID="Qwen/Qwen2.5-Coder-7B-Instruct-AWQ" \
    QUANTIZATION="awq" \
    VLLM_PORT="8000" \
    TENSOR_PARALLEL_SIZE="1" \
    MAX_MODEL_LEN="8192" \
    GPU_MEMORY_UTILIZATION="0.9" \
    MAX_NUM_SEQS="32" \
    ENABLE_PREFIX_CACHING="true" \
    HF_HOME="/root/.cache/huggingface"

# Expose the API port
EXPOSE ${VLLM_PORT}

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -sf http://localhost:${VLLM_PORT}/health || exit 1

# Entrypoint: start vLLM with environment variables
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]

CMD ["--model", "${MODEL_ID}", \
     "--quantization", "${QUANTIZATION}", \
     "--port", "${VLLM_PORT}", \
     "--tensor-parallel-size", "${TENSOR_PARALLEL_SIZE}", \
     "--max-model-len", "${MAX_MODEL_LEN}", \
     "--gpu-memory-utilization", "${GPU_MEMORY_UTILIZATION}", \
     "--max-num-seqs", "${MAX_NUM_SEQS}", \
     "--enable-prefix-caching"]
