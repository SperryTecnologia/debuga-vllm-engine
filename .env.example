# ============================================================
# debuga-vllm-engine — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ============================================================

# Hugging Face token (required for gated models)
HF_TOKEN=your-huggingface-token

# Model to serve
MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ

# vLLM server port
VLLM_PORT=8000

# Quantization method (awq, gptq, fp8, or leave empty for FP16)
QUANTIZATION=awq

# Number of GPUs for tensor parallelism (1 for single GPU)
TENSOR_PARALLEL_SIZE=1

# Maximum context length in tokens
MAX_MODEL_LEN=8192

# GPU memory utilization (0.0 to 1.0)
GPU_MEMORY_UTILIZATION=0.9

# Maximum concurrent requests
MAX_NUM_SEQS=32

# Enable prefix caching (true/false)
ENABLE_PREFIX_CACHING=true

# API key for vLLM (optional, leave empty for no auth)
VLLM_API_KEY=
